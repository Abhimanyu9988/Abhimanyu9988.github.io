== 1. The before-check: the cluster's own data reaches Splunk
cluster metric time series in Splunk: 2613
== 2. The OTTL in named.yaml and all.yaml
  named.yaml:
      filter/healthchecks:
        error_mode: ignore
        trace_conditions:
          - span.attributes["url.path"] == "/healthz"
      transform/redact:
        error_mode: ignore
        trace_statements:
          - replace_pattern(span.attributes["url.query"], "token=[^&]*", "token=REDACTED")
          - replace_pattern(span.attributes["url.full"], "token=[^&]*", "token=REDACTED")
  all.yaml:
      filter/healthchecks:
        error_mode: ignore
        trace_conditions:
          - span.attributes["url.path"] == "/healthz"
      transform/redact:
        error_mode: ignore
        trace_statements:
          - replace_all_patterns(span.attributes, "value", "token=[^&]*", "token=REDACTED")
