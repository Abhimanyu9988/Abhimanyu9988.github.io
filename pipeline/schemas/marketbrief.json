{
 "type": "object",
 "required": [
  "what_worked",
  "topics_to_try",
  "avoid",
  "sources"
 ],
 "properties": {
  "what_worked": {
   "type": "array",
   "maxItems": 5,
   "items": {
    "type": "string"
   },
   "description": "what real people did to reach this goal"
  },
  "topics_to_try": {
   "type": "array",
   "maxItems": 5,
   "items": {
    "type": "string"
   },
   "description": "article ideas that follow from it, each naming a problem, surprise or question"
  },
  "avoid": {
   "type": "array",
   "maxItems": 4,
   "items": {
    "type": "string"
   }
  },
  "sources": {
   "type": "array",
   "maxItems": 6,
   "items": {
    "type": "string"
   },
   "description": "URLs copied exactly from PAGES"
  }
 }
}
